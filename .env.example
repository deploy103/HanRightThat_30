# docker-compose.yml 이 읽는 값들. 실제 값을 넣은 .env 는 커밋하지 않는다.

# 세션 쿠키 서명에 쓰는 비밀값. 운영에서는 반드시 무작위 긴 문자열로 바꿀 것.
# 예: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-value

# 세션 유효 시간(시간 단위). 2단계 인증까지 마친 세션에만 적용된다
# (비밀번호만 통과한 임시 세션은 항상 5분).
SESSION_TTL_HOURS=8

# 관리자 2단계 인증(TOTP) secret 을 암호화할 키. 운영에서는 필수이며 없으면 서버가 뜨지 않는다.
# 반드시 64자리 hex(32바이트)여야 한다.  예: openssl rand -hex 32
# 이 값을 분실하면 등록된 모든 2FA secret 을 복호화할 수 없어 전 관리자가 재등록해야 한다.
TOTP_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# 인증 앱(Google Authenticator 등) 목록에 표시될 이름
TOTP_ISSUER=Hanbit Festival Admin

# 관리자가 올린 부스 사진 저장 위치. 데이터 볼륨 안이어야 재배포해도 사진이 남는다.
BOOTH_IMAGE_DIR=/app/data/uploads/booth-images

# admin.hanwol.site 에서만 세션 쿠키를 포함한 API 호출을 허용한다.
ADMIN_ORIGIN=https://admin.hanwol.site

# 쿠키를 admin.hanwol.site 와 hanwol.site 가 공유하도록 상위 도메인으로 설정한다.
# 로컬 개발에서는 비워 두면 host-only 쿠키로 동작한다.
COOKIE_DOMAIN=.hanwol.site

# HTTPS 운영 환경에서는 true. 로컬 http 개발에서는 false.
COOKIE_SECURE=true

# 컨테이너 포트를 바인딩할 주소.
# - 같은 VM 안에 리버스 프록시를 둔다면 기본값(127.0.0.1)을 그대로 둔다 (외부 노출 안 됨).
# - 리버스 프록시가 다른 VM(같은 프라이빗 네트워크/VPC)에 있다면, 이 VM의 프라이빗 IP로 바꾼다.
#   예: BIND_ADDR=10.0.1.5  (0.0.0.0 은 방화벽/보안그룹으로 리버스 프록시 IP만 허용했을 때만 사용)
# 어느 쪽이든 8787 포트는 리버스 프록시 서버 외에는 접근할 수 없어야 한다.
BIND_ADDR=127.0.0.1
